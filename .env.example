# Postgres bootstrap superuser; only used to create the roles below. Generate
# secrets in this file with: openssl rand -hex 24. Passwords must be alphanumeric.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# n8n's own database role
N8N_DB_USER=n8n
N8N_DB_PASSWORD=

# The app's database role, used by workflows and scripts
APP_DB_USER=app
APP_DB_PASSWORD=

# n8n instance
N8N_ENCRYPTION_KEY=
N8N_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/ # set to https://<NGROK_DOMAIN>/ for live webhooks

# ngrok
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Shopify
SHOPIFY_STORE=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ACCESS_TOKEN=

# Google OAuth (shared by the Sheets and Gmail credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
