# Postgres bootstrap superuser; only used to create the roles below. Generate
# secrets in this file with: openssl rand -hex 24. Passwords must be alphanumeric.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# n8n's own database role
N8N_DB_USER=n8n
N8N_DB_PASSWORD=

# The app's database role: owns the app database and its tables; used only by db/init and
# db-migrate, never by n8n.
APP_DB_USER=app
APP_DB_PASSWORD=

# The runtime role every Postgres node connects as: DML on named tables, no DDL (docs/database.md)
APP_RUNTIME_DB_USER=app_runtime
APP_RUNTIME_DB_PASSWORD=

# n8n instance
N8N_ENCRYPTION_KEY=
N8N_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/ # set to https://<NGROK_DOMAIN>/ for live webhooks

# ngrok
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Shopify
SHOPIFY_STORE=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ACCESS_TOKEN=

# Google OAuth (shared by the Sheets and Gmail credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Dev harness: localhost-only, header-gated access to call a sub-workflow directly.
# Generate with: openssl rand -hex 24
DEV_HARNESS_TOKEN=
