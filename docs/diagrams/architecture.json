  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Order path",
      "items": [
        "ngrok forwards only the Shopify Trigger's path",
        "shopify-orders checks the HMAC and answers 200 on receipt",
        "intake-order records each order once, then starts process-order"
      ]
    },
    {
      "dot": "violet",
      "title": "process-order",
      "items": [
        "Upserts the sheet row and emails the owner",
        "Reads stock and brew methods in one GraphQL call",
        "Waits in Postgres, then emails the brewing guide"
      ]
    },
    {
      "dot": "slate",
      "title": "Around the path",
      "items": [
        "load-config reads the mounted config for every caller",
        "error-handler emails the owner when a workflow fails",
        "dev-harness runs the intake chain from localhost only"
      ]
    }
  ]
}
