  "cards": [
    {
      "dot": "cyan",
      "title": "Order path",
      "items": [
        "ngrok forwards only the two Shopify trigger paths",
        "Each entry workflow checks the HMAC and answers 200 on receipt",
        "intake-order and cancel-order each record once, behind a gate"
      ]
    },
    {
      "dot": "violet",
      "title": "process-order",
      "items": [
        "Upserts the sheet row, reads stock, emails the owner",
        "Waits in Postgres, then skips a cancelled order",
        "Emails the guide, and starts the reminder if consented"
      ]
    },
    {
      "dot": "slate",
      "title": "Around the path",
      "items": [
        "load-config reads the mounted config for every caller",
        "error-handler emails the owner when a workflow fails",
        "dev-harness runs the intake chain from localhost only"
      ]
    }
  ]
