{
  "id": "nbcDevHarness001",
  "name": "Dev harness",
  "description": null,
  "nodes": [
    {
      "id": "40000000-0000-4000-8000-000000000001",
      "name": "Receive dev call",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        -160,
        200
      ],
      "webhookId": "40000000-aaaa-4bbb-8ccc-000000000001",
      "parameters": {
        "httpMethod": "POST",
        "path": "dev",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "nbcCredDevToken1",
          "name": "Dev harness token"
        }
      }
    },
    {
      "id": "40000000-0000-4000-8000-000000000002",
      "name": "Route by target",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.5,
      "position": [
        120,
        200
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "outputKey": "load-config",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "40000000-0001-4000-8000-0000000a0101",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.body.target }}",
                    "rightValue": "load-config"
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Unknown target"
        }
      }
    },
    {
      "id": "40000000-0000-4000-8000-000000000003",
      "name": "Call load-config",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [
        400,
        140
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "nbcLoadConfig001"
        },
        "mode": "once",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {},
          "schema": [],
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        }
      }
    },
    {
      "id": "40000000-0000-4000-8000-000000000004",
      "name": "Respond with result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        660,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "40000000-0000-4000-8000-000000000005",
      "name": "Respond unknown target",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        400,
        360
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"error\": \"unknown_target\"\n}",
        "options": {
          "responseCode": 404
        }
      }
    },
    {
      "id": "40000000-0000-4000-8000-000000000006",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -60
      ],
      "parameters": {
        "width": 1080,
        "height": 160,
        "content": "## Dev harness\nToken-protected test RPC: POST /webhook/dev with { target, input }. Routes to a fixed sub-workflow by target and responds once it returns. An unmatched target answers 404. Localhost only, never exposed through the tunnel, and must be unpublished before any production use. load-config exists today; later tasks add more targets the same way."
      }
    }
  ],
  "connections": {
    "Receive dev call": {
      "main": [
        [
          {
            "node": "Route by target",
            "type": "main",
            "index": 0
          }
        ]
      ]
