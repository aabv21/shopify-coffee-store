{
  "id": "nbcLoadConfig001",
  "name": "Load config",
  "description": null,
  "nodes": [
    {
      "id": "10000000-0000-4000-8000-000000000001",
      "name": "When called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.3,
      "position": [
        -120,
        200
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000002",
      "name": "Read config file",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        180,
        200
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
      "parameters": {
        "operation": "read",
        "fileSelector": "/files/config/config.json"
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000003",
      "name": "Parse config",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "operation": "fromJson",
        "binaryPropertyName": "data",
        "destinationKey": "data"
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000004",
      "name": "Return config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        700,
        200
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "10000000-0004-4000-8000-0000000a0001",
              "name": "config",
              "type": "object",
              "value": "={{ $json.data }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000005",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -160,
        -60
      ],
      "parameters": {
        "width": 900,
        "height": 160,
        "content": "## Load config\nReads /files/config/config.json and returns { config }. Always Output Data is on for the read step, so a missing file still reaches the parse step as an item with no binary data, which throws instead of the branch silently stopping with zero items. Returns the parsed config unvalidated; the caller decides when to check it. A failure here fails the caller, whose error workflow fires. This workflow has none of its own: Error handler calls it, so one would loop while the file is missing."
      }
    },
    {
      "id": "10000000-0000-4000-8000-000000000006",
      "name": "Sticky Note1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        440,
        380
      ],
      "parameters": {
        "width": 560,
        "height": 160,
        "content": "NOTE: this returns the config as read, not validated. The error handler loads this same file, so checking it here would make a bad hand-edit silence its own alert email. Validation runs in the caller chain instead, after Load config."
      }
    }
  ],
  "connections": {
    "When called": {
      "main": [
        [
          {
