{% doc %}
  Renders the free-shipping progress bar, updating live as the cart changes. The server renders
  the first state, so the message and the bar never start empty.
{% enddoc %}

{%- assign free_shipping_threshold_cents = settings.free_shipping_threshold | times: 100 -%}
{%- if settings.free_shipping_bar_enabled and free_shipping_threshold_cents > 0 -%}
  {%- comment -%} Each capture is already HTML-escaped (see nubandina-text), so it's printed as is below. {%- endcomment -%}
  {%- capture free_shipping_template_remaining -%}
    {%- render 'nubandina-text', value: settings.free_shipping_message_remaining, key: 'nubandina.free_shipping_bar.message_remaining' -%}
  {%- endcapture -%}
  {%- capture free_shipping_message_reached -%}
    {%- render 'nubandina-text', value: settings.free_shipping_message_reached, key: 'nubandina.free_shipping_bar.message_reached' -%}
  {%- endcapture -%}
  {%- capture free_shipping_progress_label -%}
    {%- render 'nubandina-text', value: settings.free_shipping_progress_label, key: 'nubandina.free_shipping_bar.progress_label' -%}
  {%- endcapture -%}
  {%- capture free_shipping_reassurance -%}
    {%- render 'nubandina-text', value: settings.reassurance_text, key: 'nubandina.reassurance' -%}
  {%- endcapture -%}
  {%- liquid
    assign free_shipping_total_cents = cart.total_price | at_least: 0
    assign free_shipping_percent = free_shipping_total_cents | times: 100 | divided_by: free_shipping_threshold_cents | floor | at_most: 100
    if free_shipping_total_cents >= free_shipping_threshold_cents
      assign free_shipping_state = 'reached'
      assign free_shipping_message = free_shipping_message_reached
    else
      assign free_shipping_state = 'remaining'
      assign free_shipping_remaining = free_shipping_threshold_cents | minus: free_shipping_total_cents | money | escape
      assign free_shipping_message = free_shipping_template_remaining | replace_first: '[amount]', free_shipping_remaining
    endif
  -%}
  {%- comment -%} data-skip-subtree-update keeps Horizon's morph off the JS-rendered children; it still updates data-total-cents and data-state. {%- endcomment -%}
  <free-shipping-bar
    class="free-shipping-bar"
    data-state="{{ free_shipping_state }}"
    data-total-cents="{{ cart.total_price }}"
    data-threshold-cents="{{ free_shipping_threshold_cents }}"
    data-money-format="{{ shop.money_format | escape }}"
    data-message-remaining="{{ free_shipping_template_remaining }}"
    data-message-reached="{{ free_shipping_message_reached }}"
    data-cart-url="{{ routes.cart_url }}"
    data-cart-add-url="{{ routes.cart_add_url }}"
    data-skip-subtree-update
  >
    <p class="free-shipping-bar__message">
      <svg
        class="free-shipping-bar__icon"
        aria-hidden="true"
        focusable="false"
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
      >
        <circle cx="10" cy="10" r="8.25" stroke="currentColor" stroke-width="1.5"/>
        <path d="m6.5 10.25 2.25 2.25 4.75-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span data-bar-message tabindex="-1" aria-live="polite">{{ free_shipping_message }}</span>
    </p>
    <div
      class="free-shipping-bar__track"
      data-bar-track
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ free_shipping_percent }}"
      aria-label="{{ free_shipping_progress_label }}"
    >
      <div
        class="free-shipping-bar__fill"
        data-bar-fill
        style="--free-shipping-progress: {{ free_shipping_percent | divided_by: 100.0 }};"
      ></div>
    </div>
    {%- if settings.free_shipping_suggestion_enabled -%}
      {%- capture free_shipping_suggestion_message -%}
        {%- render 'nubandina-text', value: settings.free_shipping_suggestion_message, key: 'nubandina.free_shipping_bar.suggestion_message' -%}
      {%- endcapture -%}
      {%- capture free_shipping_suggestion_add_label -%}
        {%- render 'nubandina-text', value: settings.free_shipping_suggestion_add_label, key: 'nubandina.free_shipping_bar.suggestion_add_label' -%}
      {%- endcapture -%}
      {%- capture free_shipping_suggestion_error -%}
        {%- render 'nubandina-text', value: settings.free_shipping_suggestion_error, key: 'nubandina.free_shipping_bar.suggestion_error' -%}
      {%- endcapture -%}
      {%- assign free_shipping_suggestion_products = settings.free_shipping_suggestion_collection.products | default: collections.all.products -%}
      {%- capture free_shipping_suggestions_json -%}
        [
          {%- assign free_shipping_suggestion_first = true -%}
          {%- for product in free_shipping_suggestion_products limit: 50 -%}
            {%- for variant in product.variants -%}
              {%- unless free_shipping_suggestion_first -%},{%- endunless -%}
              {%- assign free_shipping_suggestion_first = false -%}
              {%- if variant.title == 'Default Title' -%}
                {%- assign free_shipping_suggestion_label = product.title -%}
              {%- else -%}
                {%- assign free_shipping_suggestion_label = product.title | append: ' ' | append: variant.title -%}
              {%- endif -%}
              {
                "variantId": {{ variant.id | json }},
                "label": {{ free_shipping_suggestion_label | json }},
                "priceCents": {{ variant.price | json }},
                "price": {{ variant.price | money | json }},
                "available": {{ variant.available | json }}
              }
            {%- endfor -%}
          {%- endfor -%}
        ]
      {%- endcapture -%}
      <div
        class="free-shipping-bar__suggestion"
        data-bar-suggestion
        hidden
        data-message="{{ free_shipping_suggestion_message }}"
        data-error="{{ free_shipping_suggestion_error }}"
      >
        <span data-suggestion-text></span>
        <button type="button" class="button-secondary free-shipping-bar__suggestion-add" data-suggestion-add>{{ free_shipping_suggestion_add_label }}</button>
        <span class="free-shipping-bar__suggestion-status" data-suggestion-status role="status"></span>
      </div>
      {%- comment -%} shopify.dev's json filter docs promise only quote escaping, so a product title containing "</script>" is neutralized here. {%- endcomment -%}
      <script type="application/json" data-bar-suggestions>{{ free_shipping_suggestions_json | strip | replace: '</', '<\/' }}</script>
    {%- endif -%}
    {%- if settings.reassurance_enabled and free_shipping_reassurance != blank -%}
      <p class="free-shipping-bar__reassurance">{{ free_shipping_reassurance }}</p>
    {%- endif -%}
  </free-shipping-bar>
  <script src="{{ 'free-shipping-bar.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% stylesheet %}
  .free-shipping-bar {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .free-shipping-bar__message {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    margin: 0;
    color: var(--color-foreground);
    text-wrap: pretty;
  }

  .free-shipping-bar__icon {
    flex: none;
    inline-size: var(--icon-size-sm);
    block-size: var(--icon-size-sm);
    color: var(--color-primary-button-background);
  }

  .free-shipping-bar:not([data-state='reached']) .free-shipping-bar__icon {
    display: none;
  }

  .free-shipping-bar[data-state='reached'] .free-shipping-bar__message {
    font-weight: 700;
  }

  .free-shipping-bar__suggestion {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-xs);
  }

  .free-shipping-bar__suggestion [data-suggestion-text] {
    flex: 1 1 14rem;
    text-wrap: pretty;
  }

  .free-shipping-bar__message [data-bar-message]:focus-visible {
    outline-offset: 2px;
  }

  .free-shipping-bar__suggestion[hidden] {
    display: none;
  }

  /* Horizon's button padding makes this as tall as Checkout; the padding goes and the 44 px touch
     target stays, so the button sits beside its sentence. */
  .free-shipping-bar__suggestion-add {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-block: 0;
    padding-inline: var(--padding-lg);
    min-block-size: var(--minimum-touch-target);
  }

  .free-shipping-bar__suggestion-add[aria-busy='true'] {
    opacity: var(--opacity-50);
  }

  .free-shipping-bar__reassurance {
    margin: 0;
    font-size: var(--font-size--sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-muted-text));
    text-wrap: pretty;
  }

  .free-shipping-bar__track {
    block-size: 0.5rem;
    border-radius: var(--style-border-radius-pills);
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    overflow: hidden;
  }

  /* The fill is always full width and slides into view, so its rounded end never distorts. The
     extra pixel keeps an empty bar's antialiased edge out of sight. */
  .free-shipping-bar__fill {
    block-size: 100%;
    inline-size: 100%;
    border-radius: inherit;
    background-color: var(--color-primary-button-background);
    transform: translateX(calc((var(--free-shipping-progress, 0) - 1) * (100% + 1px)));
  }

  [dir='rtl'] .free-shipping-bar__fill {
    transform: translateX(calc((1 - var(--free-shipping-progress, 0)) * (100% + 1px)));
  }

  @media (prefers-reduced-motion: no-preference) {
    .free-shipping-bar__fill {
      transition: transform var(--animation-speed-slow) var(--ease-out-cubic);
    }
  }
{% endstylesheet %}
