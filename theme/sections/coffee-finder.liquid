{%- comment -%} The doc tag is snippet/block-only in Shopify's Liquid; sections carry no top-of-file doc block. {%- endcomment -%}
{%- liquid
  assign finder_collection = section.settings.collection
  if finder_collection == blank
    assign finder_collection = collections.all
  endif
  assign finder_products = finder_collection.products | slice: 0, 50
-%}

<coffee-finder class="coffee-finder" data-cart-add-url="{{ routes.cart_add_url }}" data-cart-url="{{ routes.cart_url }}">
  <div class="coffee-finder__intro">
    <h2 class="coffee-finder__heading">{{ section.settings.heading | escape }}</h2>
    <p class="coffee-finder__text">{{ section.settings.intro | escape }}</p>
  </div>

  <form data-finder-form class="coffee-finder__form" novalidate>
    <fieldset class="coffee-finder__fieldset">
      <legend class="coffee-finder__legend">{{ section.settings.brew_question | escape }}</legend>
      <label class="coffee-finder__option">
        <input type="radio" name="brew_method" value="pour-over" required>
        <span>{{ section.settings.brew_pour_over | escape }}</span>
      </label>
      <label class="coffee-finder__option">
        <input type="radio" name="brew_method" value="espresso">
        <span>{{ section.settings.brew_espresso | escape }}</span>
      </label>
      <label class="coffee-finder__option">
        <input type="radio" name="brew_method" value="french-press">
        <span>{{ section.settings.brew_french_press | escape }}</span>
      </label>
    </fieldset>

    <fieldset class="coffee-finder__fieldset">
      <legend class="coffee-finder__legend">{{ section.settings.taste_question | escape }}</legend>
      <label class="coffee-finder__option">
        <input type="radio" name="taste" value="mild" required>
        <span>{{ section.settings.taste_mild | escape }}</span>
      </label>
      <label class="coffee-finder__option">
        <input type="radio" name="taste" value="balanced">
        <span>{{ section.settings.taste_balanced | escape }}</span>
      </label>
      <label class="coffee-finder__option">
        <input type="radio" name="taste" value="intense">
        <span>{{ section.settings.taste_intense | escape }}</span>
      </label>
    </fieldset>

    <fieldset class="coffee-finder__fieldset">
      <legend class="coffee-finder__legend">{{ section.settings.people_question | escape }}</legend>
      <label class="coffee-finder__option">
        <input type="radio" name="people" value="1" required>
        <span>{{ section.settings.people_one | escape }}</span>
      </label>
      <label class="coffee-finder__option">
        <input type="radio" name="people" value="2">
        <span>{{ section.settings.people_two | escape }}</span>
      </label>
      <label class="coffee-finder__option">
        <input type="radio" name="people" value="3">
        <span>{{ section.settings.people_three_plus | escape }}</span>
      </label>
    </fieldset>

    <button type="submit" class="coffee-finder__submit">{{ section.settings.submit_label | escape }}</button>
  </form>

  <div data-finder-results class="coffee-finder__results" aria-live="polite" hidden>
    <h3 data-finder-heading class="coffee-finder__results-heading" tabindex="-1">{{ section.settings.results_heading | escape }}</h3>
    <p data-finder-empty class="coffee-finder__empty" hidden>{{ section.settings.empty_text | escape }}</p>
    <ul data-finder-list class="coffee-finder__list"></ul>
  </div>

  <template data-finder-card>
    <li class="coffee-finder__card">
      <img data-card-image class="coffee-finder__card-image" alt="" width="400" height="400" loading="lazy">
      <div class="coffee-finder__card-body">
        <p data-card-title class="coffee-finder__card-title"></p>
        <p data-card-variant class="coffee-finder__card-variant"></p>
        <p data-card-notes class="coffee-finder__card-notes"></p>
        <p data-card-price class="coffee-finder__card-price"></p>
        <a data-card-link class="coffee-finder__card-link" href=""></a>
        <button type="button" data-card-add class="coffee-finder__card-add">
          {{ section.settings.add_label | escape }}
          <span class="visually-hidden" data-card-add-name></span>
        </button>
        <p data-card-status class="coffee-finder__card-status" aria-live="polite"></p>
      </div>
    </li>
  </template>

  <span data-finder-messages hidden data-added="{{ section.settings.added_text | escape }}" data-error="{{ section.settings.error_text | escape }}"></span>

  {%- capture finder_products_json -%}
    [
      {%- for product in finder_products -%}
        {%- unless forloop.first -%},{%- endunless -%}
        {
          "id": {{ product.id | json }},
          "title": {{ product.title | json }},
          "url": {{ product.url | json }},
          "image": {% if product.featured_image %}{ "src": {{ product.featured_image | image_url: width: 400 | json }}, "alt": {{ product.featured_image.alt | json }} }{% else %}null{% endif %},
          "roast": {{ product.metafields.coffee.roast.value | json }},
          "brewMethod": {{ product.metafields.coffee.brew_method.value | json }},
          "tastingNotes": {{ product.metafields.coffee.tasting_notes.value | json }},
          "variants": [
            {%- for variant in product.variants -%}
              {%- unless forloop.first -%},{%- endunless -%}
              {
                "id": {{ variant.id | json }},
                "title": {{ variant.title | json }},
                "grams": {{ variant.weight | json }},
                "available": {{ variant.available | json }},
                "price": {{ variant.price | money | json }}
              }
            {%- endfor -%}
          ]
        }
      {%- endfor -%}
    ]
  {%- endcapture -%}
  {%- comment -%} shopify.dev's json filter docs only promise quote escaping, not </, so a merchant-entered tasting note containing "</script>" is neutralized here before embedding. {%- endcomment -%}
  <script type="application/json" data-finder-products>{{ finder_products_json | strip | replace: '</', '<\/' }}</script>
</coffee-finder>

<script src="{{ 'coffee-finder.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .coffee-finder {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }

  .coffee-finder__intro {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
  }

  .coffee-finder__heading {
    margin: 0;
  }

  .coffee-finder__text {
    margin: 0;
    color: var(--color-foreground);
  }

  .coffee-finder__form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .coffee-finder__fieldset {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
    margin: 0;
    padding: 0;
    border: none;
  }

  .coffee-finder__legend {
    padding: 0;
    font-weight: bold;
  }

  .coffee-finder__option {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
  }

  .coffee-finder__submit {
    align-self: flex-start;
  }

  .coffee-finder__results[hidden] {
    display: none;
  }

  .coffee-finder__results-heading:focus {
    outline: none;
  }

  .coffee-finder__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .coffee-finder__card {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
  }

  .coffee-finder__card-image {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--style-border-radius-inputs);
    object-fit: cover;
  }

  .coffee-finder__card-add[aria-busy='true'] {
    opacity: var(--opacity-80);
  }

  @media screen and (min-width: 750px) {
    .coffee-finder__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Coffee finder",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your coffee" },
    { "type": "text", "id": "intro", "label": "Intro text", "default": "Answer three quick questions and we'll pick a bag for you." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave blank to search every product." },
    { "type": "text", "id": "brew_question", "label": "Brew method question", "default": "How do you brew at home?" },
    { "type": "text", "id": "brew_pour_over", "label": "Brew method: pour-over", "default": "Pour-over" },
    { "type": "text", "id": "brew_espresso", "label": "Brew method: espresso", "default": "Espresso" },
    { "type": "text", "id": "brew_french_press", "label": "Brew method: French press", "default": "French press" },
    { "type": "text", "id": "taste_question", "label": "Taste question", "default": "What flavor do you enjoy?" },
    { "type": "text", "id": "taste_mild", "label": "Taste: mild", "default": "Mild and bright" },
    { "type": "text", "id": "taste_balanced", "label": "Taste: balanced", "default": "Balanced" },
    { "type": "text", "id": "taste_intense", "label": "Taste: intense", "default": "Bold and intense" },
    { "type": "text", "id": "people_question", "label": "People question", "default": "How many people drink it?" },
    { "type": "text", "id": "people_one", "label": "People: one", "default": "Just me" },
    { "type": "text", "id": "people_two", "label": "People: two", "default": "Two of us" },
    { "type": "text", "id": "people_three_plus", "label": "People: three or more", "default": "Three or more" },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Find my coffee" },
    { "type": "text", "id": "results_heading", "label": "Results heading", "default": "Our pick for you" },
    { "type": "text", "id": "empty_text", "label": "No match text", "default": "No coffee matches those answers right now. Try a different option." },
    { "type": "text", "id": "add_label", "label": "Add to cart button label", "default": "Add to cart" },
    { "type": "text", "id": "added_text", "label": "Added to cart message", "default": "Added to your cart." },
    { "type": "text", "id": "error_text", "label": "Cart error message", "default": "We couldn't add this to your cart. Please try again." }
  ],
  "presets": [{ "name": "Coffee finder" }]
}
{% endschema %}
